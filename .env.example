# ============================================================
# The Bunker Indoor Golf — environment variables
# Copy to .env.local and fill in real values. Never commit
# real credentials. Server-only secrets must NOT be prefixed
# with NEXT_PUBLIC_.
# ============================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional default business mode when the DB has no value:
# pre_opening | reservations_open | fully_operational | temporarily_closed
BUSINESS_MODE=
# America/Indiana/Indianapolis is the facility time zone.
NEXT_PUBLIC_FACILITY_TIMEZONE=America/Indiana/Indianapolis

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Used by admin tasks, webhooks and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Square (primary payment provider + seller dashboard) ---
# Access token from developer.squareup.com (sandbox or production)
SQUARE_ACCESS_TOKEN=
# "sandbox" (default) or "production"
SQUARE_ENVIRONMENT=sandbox
# Optional — defaults to the account's first active location
SQUARE_LOCATION_ID=
# Signature key from the webhook subscription (Developer Dashboard →
# Webhooks → your endpoint). Endpoint URL: <site>/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Optional: the EXACT Notification URL configured on the Square webhook
# subscription, if it differs from <NEXT_PUBLIC_SITE_URL>/api/webhooks/square
# (e.g. a specific Vercel alias). The webhook also auto-detects the URL
# Square called, so this is rarely needed.
SQUARE_WEBHOOK_URL=

# --- Stripe (legacy/optional: membership billing portal) ---
# Server-side secret key (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=
# Publishable key used by Stripe.js in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Verified sending address, e.g. "The Bunker <hello@thebunkerlinton.com>"
EMAIL_FROM=
# Where staff notifications (private event inquiries, etc.) are sent
STAFF_NOTIFICATIONS_EMAIL=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Error monitoring (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Cron / internal jobs ---
# Shared secret required by internal job endpoints (booking reminders, hold cleanup)
CRON_SECRET=
